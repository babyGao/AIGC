{
 "dur": 216.29,
 "audio": "assets/audio/narration.m4s",
 "cues": [
  {
   "t0": 7.25,
   "t1": 11.15,
   "who": "雪胡老祖",
   "text": "该死！柳贯一，你竟然杀死了他"
  },
  {
   "t0": 11.15,
   "t1": 14.77,
   "who": "雪胡老祖",
   "text": "我要把你抽筋扒皮，让你不得好死啊！！"
  },
  {
   "t0": 14.77,
   "t1": 16.83,
   "who": "旁白",
   "text": "雪胡老祖仰天咆哮，双目赤红"
  },
  {
   "t0": 16.83,
   "t1": 22.29,
   "who": "旁白",
   "text": "马鸿运一死，他的齐天鸿运就当即消散了"
  },
  {
   "t0": 22.29,
   "t1": 23.33,
   "who": "碧晨天",
   "text": "马鸿运……"
  },
  {
   "t0": 23.9,
   "t1": 26.8,
   "who": "旁白",
   "text": "碧晨天、威灵仰等人失神落魄"
  },
  {
   "t0": 26.8,
   "t1": 30.06,
   "who": "毛里球",
   "text": "小臭虫，你居然夹死了马鸿运"
  },
  {
   "t0": 30.06,
   "t1": 32.08,
   "who": "毛里球",
   "text": "你把他夹死了！！！"
  },
  {
   "t0": 32.3,
   "t1": 36.64,
   "who": "旁白",
   "text": "毛里球爆发出比雪胡老祖还要高的音量"
  },
  {
   "t0": 36.64,
   "t1": 39.48,
   "who": "方源",
   "text": "马鸿运居然就这样死了？！"
  },
  {
   "t0": 39.48,
   "t1": 42.48,
   "who": "方源",
   "text": "没关系，我还有赵怜云"
  },
  {
   "t0": 42.58,
   "t1": 44.94,
   "who": "旁白",
   "text": "方源强忍心中震动"
  },
  {
   "t0": 44.94,
   "t1": 45.6,
   "who": "方源",
   "text": "不好。"
  },
  {
   "t0": 45.6,
   "t1": 48.76,
   "who": "旁白",
   "text": "方源连忙出手，想要将赵怜云敲昏"
  },
  {
   "t0": 48.76,
   "t1": 52.78,
   "who": "旁白",
   "text": "就是为了防止赵怜云悲伤过度，也死在当场"
  },
  {
   "t0": 52.78,
   "t1": 54.52,
   "who": "旁白",
   "text": "九转爱情仙蛊！"
  },
  {
   "t0": 54.52,
   "t1": 57.84,
   "who": "旁白",
   "text": "在最关键的时刻，它再次展现威能"
  },
  {
   "t0": 57.84,
   "t1": 59.14,
   "who": "方源",
   "text": "天意！"
  },
  {
   "t0": 59.17,
   "t1": 60.23,
   "who": "旁白",
   "text": "方源仰头"
  },
  {
   "t0": 60.23,
   "t1": 62.45,
   "who": "旁白",
   "text": "这一刻，他四面楚歌"
  },
  {
   "t0": 62.84,
   "t1": 66.43,
   "who": "方源",
   "text": "绝境么……那么，我该如何是好？"
  },
  {
   "t0": 66.43,
   "t1": 69.69,
   "who": "蛊仙",
   "text": "柳贯一，你今日难逃一死"
  },
  {
   "t0": 70.04,
   "t1": 75.16,
   "who": "蛊仙",
   "text": "你知不知道，你杀了你绝不能触碰的对象"
  },
  {
   "t0": 75.16,
   "t1": 77.04,
   "who": "蛊仙",
   "text": "今日你必死无疑！！"
  },
  {
   "t0": 78.03,
   "t1": 79.91,
   "who": "旁白",
   "text": "逆流河是没有尽头的"
  },
  {
   "t0": 79.91,
   "t1": 81.41,
   "who": "旁白",
   "text": "这是一种绝望"
  },
  {
   "t0": 81.48,
   "t1": 83.58,
   "who": "旁白",
   "text": "不过方源却不以为意"
  },
  {
   "t0": 83.77,
   "t1": 88.88,
   "who": "方源",
   "text": "在我的一生中，经历的绝望实在太多太多了啊"
  },
  {
   "t0": 88.88,
   "t1": 90.2,
   "who": "旁白",
   "text": "方源心中叹息"
  },
  {
   "t0": 90.2,
   "t1": 91.76,
   "who": "旁白",
   "text": "一步再一步"
  },
  {
   "t0": 91.76,
   "t1": 94.52,
   "who": "旁白",
   "text": "时间流逝，方源在不断前行"
  },
  {
   "t0": 94.52,
   "t1": 99.6,
   "who": "旁白",
   "text": "不知不觉间，狗尾续命貂毛里球的吼叫声，低弱了下来"
  },
  {
   "t0": 99.6,
   "t1": 100.6,
   "who": "毛里球",
   "text": "不会吧……"
  },
  {
   "t0": 100.91,
   "t1": 102.99,
   "who": "蛊仙",
   "text": "为什么他面无表情？"
  },
  {
   "t0": 102.99,
   "t1": 105.75,
   "who": "旁白",
   "text": "不知哪位蛊仙忽然开口问道"
  },
  {
   "t0": 105.75,
   "t1": 108.87,
   "who": "旁白",
   "text": "群仙这才反应过来。是啊"
  },
  {
   "t0": 108.87,
   "t1": 112.87,
   "who": "旁白",
   "text": "除去方源之外，其他跋涉之人"
  },
  {
   "t0": 112.87,
   "t1": 116.21,
   "who": "旁白",
   "text": "不是神情扭曲，就是痛苦万分"
  },
  {
   "t0": 116.21,
   "t1": 119.35,
   "who": "旁白",
   "text": "不是疯狂，就是哭泣"
  },
  {
   "t0": 119.35,
   "t1": 125.09,
   "who": "旁白",
   "text": "为什么方源，他始终面无表情？"
  },
  {
   "t0": 125.09,
   "t1": 126.15,
   "who": "蛊仙",
   "text": "这怎么可能？"
  },
  {
   "t0": 126.63,
   "t1": 130.44,
   "who": "蛊仙",
   "text": "大家都被淘汰，都被逆流河冲刷出来"
  },
  {
   "t0": 130.44,
   "t1": 135.28,
   "who": "蛊仙",
   "text": "他怎么还留在这里，还一副留有余力的样子？"
  },
  {
   "t0": 135.28,
   "t1": 136.58,
   "who": "蛊仙",
   "text": "凭什么是他？"
  },
  {
   "t0": 136.58,
   "t1": 138.2,
   "who": "蛊仙",
   "text": "为什么是他！"
  },
  {
   "t0": 142.11,
   "t1": 144.59,
   "who": "旁白",
   "text": "一个人的坚持会有多难？"
  },
  {
   "t0": 144.59,
   "t1": 148.21,
   "who": "旁白",
   "text": "在场的所有蛊仙，都能回答这个问题"
  },
  {
   "t0": 148.5,
   "t1": 149.7,
   "who": "旁白",
   "text": "因为他们当中"
  },
  {
   "t0": 149.7,
   "t1": 151.74,
   "who": "旁白",
   "text": "有的因为责任而坚持"
  },
  {
   "t0": 151.74,
   "t1": 153.82,
   "who": "旁白",
   "text": "有的因为仇恨而坚持"
  },
  {
   "t0": 153.82,
   "t1": 155.86,
   "who": "旁白",
   "text": "有的因为精彩而坚持"
  },
  {
   "t0": 155.86,
   "t1": 159.02,
   "who": "旁白",
   "text": "有的因为爱情而坚持……"
  },
  {
   "t0": 160.2,
   "t1": 161.78,
   "who": "旁白",
   "text": "而方源的回答呢？"
  },
  {
   "t0": 161.78,
   "t1": 165.84,
   "who": "旁白",
   "text": "他仍旧面无表情，毫无所动地向前进"
  },
  {
   "t0": 166.54,
   "t1": 171.84,
   "who": "方源",
   "text": "我曾经呐喊过，渐渐的我不发出声音"
  },
  {
   "t0": 171.92,
   "t1": 176.17,
   "who": "方源",
   "text": "我曾经哭泣过，渐渐的我不再流泪"
  },
  {
   "t0": 176.17,
   "t1": 180.73,
   "who": "方源",
   "text": "我曾经悲伤过，渐渐的我能承受一切"
  },
  {
   "t0": 180.73,
   "t1": 185.79,
   "who": "方源",
   "text": "我曾经喜悦过，渐渐的我看淡世间"
  },
  {
   "t0": 186.08,
   "t1": 189.81,
   "who": "方源",
   "text": "而如今！我只剩下面无表情"
  },
  {
   "t0": 189.81,
   "t1": 193.23,
   "who": "方源",
   "text": "我的目光如磐石般坚硬"
  },
  {
   "t0": 193.23,
   "t1": 196.94,
   "who": "方源",
   "text": "我的心中只剩下坚持"
  },
  {
   "t0": 196.94,
   "t1": 198.92,
   "who": "方源",
   "text": "这就是我"
  },
  {
   "t0": 198.92,
   "t1": 201.08,
   "who": "方源",
   "text": "一个小人物"
  },
  {
   "t0": 201.08,
   "t1": 204.02,
   "who": "方源",
   "text": "方源的——坚持！"
  },
  {
   "t0": 204.68,
   "t1": 208.52,
   "who": "旁白",
   "text": "光芒骤放，不可逼视"
  },
  {
   "t0": 208.52,
   "t1": 210.44,
   "who": "旁白",
   "text": "坚持仙蛊"
  },
  {
   "t0": 210.44,
   "t1": 211.98,
   "who": "旁白",
   "text": "在这一刻"
  },
  {
   "t0": 211.98,
   "t1": 213.96,
   "who": "旁白",
   "text": "炼成！！！"
  }
 ]
}