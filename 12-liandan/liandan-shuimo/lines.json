[
 {
  "id": "L01",
  "text": "市面上的一瓶，二百粒。"
 },
 {
  "id": "L02",
  "text": "古人服丸，一次只一丸。"
 },
 {
  "id": "L03",
  "text": "抚松的参，岷县的当归，温县的山药。廿一味，分三路。"
 },
 {
  "id": "L05",
  "text": "烘透，碾细，过一百目的罗。"
 },
 {
  "id": "L06",
  "text": "白蜜慢熬，泡由粗转细。"
 },
 {
  "id": "L07",
  "text": "离火。"
 },
 {
  "id": "L08",
  "text": "粉入蜜。一拍融一层，由亮转哑，由浅入深。"
 },
 {
  "id": "L09",
  "text": "搓圆，过一层油，乌亮如漆。"
 },
 {
  "id": "L10",
  "text": "古人为此，立这一丸。"
 },
 {
  "id": "L11",
  "text": "病根，在一个泄字。"
 },
 {
  "id": "L12",
  "text": "土居中，是升降的枢轴。"
 },
 {
  "id": "L13",
  "text": "木火从左升，金水自右降。"
 },
 {
  "id": "L14",
  "text": "阴中有阳，阳中有阴。这，才是一丸。"
 },
 {
  "id": "L15",
  "text": "亏掉的，急不来。一日一丸，百日为期。"
 },
 {
  "id": "L16",
  "text": "先甜，后苦，再暖。"
 },
 {
  "id": "L17",
  "text": "三丸，抵得上一瓶。"
 },
 {
  "id": "L18",
  "text": "好药，不怕慢。"
 }
]