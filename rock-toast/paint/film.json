 "vo": [
  {
   "id": "v00",
   "at": 0.2,
   "text": "热量炸弹！巨石强森的放纵餐。",
   "nocap": true,
   "dur": 2.869
  },
  {
   "id": "v01",
   "at": 3.45,
   "text": "这一口，是强森留给自己的放纵。",
   "dur": 2.898
  },
  {
   "id": "v02",
   "at": 6.927,
   "text": "四英寸厚的吐司，",
   "dur": 1.659
  },
  {
   "id": "v03",
   "at": 8.677,
   "text": "一百毫升牛奶，两颗鸡蛋，一勺肉桂。",
   "dur": 3.776
  },
  {
   "id": "v04",
   "at": 12.477,
   "text": "每一面，都喝饱蛋液。",
   "dur": 2.089
  },
  {
   "id": "v05",
   "at": 14.727,
   "text": "翻一次面，焦香就深一层。",
   "dur": 2.505
  },
  {
   "id": "v06",
   "at": 19.277,
   "text": "花生奶油酱，顺着边缘慢慢垂下；",
   "dur": 3.328
  },
  {
   "id": "v07",
   "at": 22.727,
   "text": "蓝莓果酱，整勺落下；",
   "dur": 2.301
  },
  {
   "id": "v08",
   "at": 25.327,
   "text": "最后，一线枫糖。",
   "dur": 1.923
  },
  {
   "id": "v09",
   "at": 28.627,
   "text": "一叉下去，外脆，里软，蛋奶香冒出来。",
   "dur": 4.071
  },
  {
   "id": "v10",
   "at": 33.077,
   "text": "热量很高，可练完腿的周日早上，就该有这一口。",
   "dur": 4.389
  },
  {
   "id": "v11",
   "at": 38.027,
   "text": "巨石吐司。",
   "dur": 1.203
  }
 ],
